    {
      "id": "RULE-1",
      "title": "RULE 1 - RATING PROCEDURE",
      "clauses": [
        {
          "clause_id": "MM-RM-CP-2025#RULE-1/1.1",
          "doc_id": "MM-RM-CP-2025",
          "section": "RULE-1",
          "section_title": "RULE 1 - RATING PROCEDURE",
          "ref": "1.1",
          "page": 1,
          "text": "1.1 Premium for Coverage COV-A and COV-B is computed as: Limit of Insurance / 100 x Base Rate x Territory Factor x Protection Class Factor x Deductible Factor x Safeguard Factors, plus endorsement premiums.",
          "full_text": "1.1 Premium for Coverage COV-A and COV-B is computed as: Limit of Insurance / 100 x Base Rate x Territory Factor x Protection Class Factor x Deductible Factor x Safeguard Factors, plus endorsement premiums.",
          "exceptions": [],
          "ids": {
            "coverage": [
              "COV-A",
              "COV-B"
            ]
          }
        },
        {
          "clause_id": "MM-RM-CP-2025#RULE-1/1.2",
          "doc_id": "MM-RM-CP-2025",
          "section": "RULE-1",
          "section_title": "RULE 1 - RATING PROCEDURE",
          "ref": "1.2",
          "page": 1,
          "text": "1.2 COV-D (Business Income) is rated at 80% of the COV-A rate applied to the COV-D limit.",
          "full_text": "1.2 COV-D (Business Income) is rated at 80% of the COV-A rate applied to the COV-D limit.",
          "exceptions": [],
          "ids": {
            "coverage": [
              "COV-A",
              "COV-D"
            ]
          }
        },
        {
