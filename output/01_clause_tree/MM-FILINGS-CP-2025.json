      "title": "SECTION 4 - FILING COMPLIANCE RULES",
      "clauses": [
        {
          "clause_id": "MM-FILINGS-CP-2025#SECTION-4/4.1",
          "doc_id": "MM-FILINGS-CP-2025",
          "section": "SECTION-4",
          "section_title": "SECTION 4 - FILING COMPLIANCE RULES",
          "ref": "4.1",
          "page": 2,
          "text": "4.1 A form may be attached to a policy only in a state where this register shows the status Approved for that form and edition on or before the policy effective date.",
          "full_text": "4.1 A form may be attached to a policy only in a state where this register shows the status Approved for that form and edition on or before the policy effective date.",
          "exceptions": [],
          "ids": {}
        },
        {
          "clause_id": "MM-FILINGS-CP-2025#SECTION-4/4.2",
          "doc_id": "MM-FILINGS-CP-2025",
          "section": "SECTION-4",
          "section_title": "SECTION 4 - FILING COMPLIANCE RULES",
          "ref": "4.2",
          "page": 2,
          "text": "4.2 When a form edition is replaced, the superseded edition must not be used on new business after the effective date of the replacing filing and must be replaced at the first renewal.",
          "full_text": "4.2 When a form edition is replaced, the superseded edition must not be used on new business after the effective date of the replacing filing and must be replaced at the first renewal.",
          "exceptions": [],
          "ids": {}
        },
        {
          "clause_id": "MM-FILINGS-CP-2025#SECTION-4/4.3",
          "doc_id": "MM-FILINGS-CP-2025",
          "section": "SECTION-4",
          "section_title": "SECTION 4 - FILING COMPLIANCE RULES",
          "ref": "4.3",
          "page": 2,
          "text": "4.3 Compliance must review this register at every renewal cycle and notify Underwriting of any withdrawn or disapproved form within 5 business days.",
          "full_text": "4.3 Compliance must review this register at every renewal cycle and notify Underwriting of any withdrawn or disapproved form within 5 business days.",
