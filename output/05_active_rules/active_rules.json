{
  "rules": [
    {
      "rule_id": "R01",
      "dsl": "PROHIBITION Claim pay_for_loss Peril:Flood WHEN Claim.onPolicy.hasForm = MM-CP-0010 SOURCE MM-CP-0010#SECTION-B/B.1 UNLESS Claim.onPolicy.hasEndorsement = MM-CP-E101 AND Claim.atLocation.scheduledUnder = MM-CP-E101 AND Claim.affectsCoverage IN (COV-A, COV-B)",
      "ast": {
        "deontic": "PROHIBITION",
        "subject": "Claim",
        "action": "pay_for_loss",
        "object": {
          "type": "Peril",
          "ids": [
            "Flood"
          ]
        },
        "when": [
          {
            "path": [
              "Claim",
              "onPolicy",
              "hasForm"
            ],
            "op": "=",
            "value": {
              "id": "MM-CP-0010"
            }
          }
        ],
        "requires": [],
        "unless": [
          [
            {
              "path": [
                "Claim",
                "onPolicy",
                "hasEndorsement"
              ],
              "op": "=",
              "value": {
                "id": "MM-CP-E101"
              }
            },
            {
              "path": [
                "Claim",
                "atLocation",
                "scheduledUnder"
              ],
              "op": "=",
              "value": {
                "id": "MM-CP-E101"
              }
            },
            {
              "path": [
                "Claim",
                "affectsCoverage"
              ],
              "op": "IN",
              "value": {
                "list": [
                  "COV-A",
                  "COV-B"
                ]
              }
            }
          ]
        ],
        "within": null,
        "source": "MM-CP-0010#SECTION-B/B.1"
      },
      "message": "Flood is excluded (EXCL-FLD, MM-CP-1030 B.1.g via MM-CP-0010 Section B.1). Check for a restoring endorsement.",
      "source_clause": "MM-CP-0010#SECTION-B/B.1",
      "layer2_deontic": "Permission",
      "shape_iri": "https://example.org/pc/shape/R01",
      "status": "scoped",
      "warnings": [],
      "overridden_by": [
        "R02"
      ]
    },
