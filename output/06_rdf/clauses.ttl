pcd:MM-CP-E-SERIES_5-MM-CP-FL-01_5.2 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CP-E-SERIES 5.2" ;
    prov:wasDerivedFrom pcd:MM-CP-E-SERIES ;
    pc:chunkText "[MM-CP-E-SERIES 5. MM-CP-FL-01 - FLORIDA AMENDATORY ENDORSEMENT (Ed. 07/2025) 5.2 p.3] 5.2 Cancellation. We may cancel this policy only for the reasons permitted by Florida law and we must mail written notice of cancellation at least 45 days before the effective date of cancellation, except 10 days for nonpayment of premium." ;
