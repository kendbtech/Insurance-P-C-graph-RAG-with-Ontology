pcd:MM-CP-0010_SECTION-C_C.1 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CP-0010 C.1" ;
    prov:wasDerivedFrom pcd:MM-CP-0010 ;
    pc:chunkText "[MM-CP-0010 SECTION C - LIMITS OF INSURANCE C.1 p.2] C.1 The most we will pay for loss or damage in any one occurrence is the applicable Limit of Insurance shown in the Declarations." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "C.1 The most we will pay for loss or damage in any one occurrence is the applicable Limit of Insurance shown in the Declarations." ;
    pc:confidence 1.0 ;
    pc:deonticType pcd:Permission ;
    pc:groundedTerm pcd:COV-C,
        pc:Coverage,
        pc:PolicyForm ;
    pc:pageNumber 2 ;
