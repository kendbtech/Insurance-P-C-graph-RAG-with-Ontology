    pc:pageNumber 3 ;
    pc:sectionRef "SECTION 4 - PROOF OF LOSS AND PAYMENT / 4.2" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-4_4.3 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 4.3" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 4 - PROOF OF LOSS AND PAYMENT 4.3 p.3] 4.3 When a percentage deductible applies under MM-CP-E310 or MM-CP-E101, the adjuster must document the Limit of Insurance used to calculate the deductible and the resulting dollar amount." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "4.3 When a percentage deductible applies under MM-CP-E310 or MM-CP-E101, the adjuster must document the Limit of Insurance used to calculate the deductible and the resulting dollar amount." ;
    pc:confidence 1.0 ;
    pc:deonticType pcd:Obligation ;
    pc:groundedTerm pc:ClaimsManual,
        pc:Form,
        pc:RatingFactor ;
    pc:mentions pcd:MM-CP-E101,
        pcd:MM-CP-E310 ;
    pc:pageNumber 3 ;
    pc:sectionRef "SECTION 4 - PROOF OF LOSS AND PAYMENT / 4.3" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-5_5.1 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 5.1" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 5 - VACANCY AND PROTECTIVE SAFEGUARDS 5.1 p.3] 5.1 For any theft, vandalism, sprinkler leakage or water damage claim the adjuster must determine whether the building was vacant for more than 60 consecutive days before the loss (MM-CP-0010 Section E.5). If so, the loss is not covered." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "5.1 For any theft, vandalism, sprinkler leakage or water damage claim the adjuster must determine whether the building was vacant for more than 60 consecutive days before the loss (MM-CP-0010 Section E.5). If so, the loss is not covered." ;
    pc:confidence 0.688 ;
    pc:deonticType pcd:Prohibition ;
    pc:groundedTerm pcd:CommercialProperty,
        pcd:SprinklerLeakage,
        pc:Claim ;
    pc:mentions pcd:MM-CP-0010,
        pcd:SprinklerLeakage,
        pcd:Theft,
        pcd:Vandalism,
        pcd:Water ;
    pc:pageNumber 3 ;
    pc:sectionRef "SECTION 5 - VACANCY AND PROTECTIVE SAFEGUARDS / 5.1" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-5_5.2 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 5.2" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 5 - VACANCY AND PROTECTIVE SAFEGUARDS 5.2 p.3] 5.2 For fire losses at premises with MM-CP-E415, the adjuster must obtain evidence that the scheduled protective safeguards were operational, or that any impairment was reported to us within 48 hours." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "5.2 For fire losses at premises with MM-CP-E415, the adjuster must obtain evidence that the scheduled protective safeguards were operational, or that any impairment was reported to us within 48 hours." ;
    pc:confidence 1.0 ;
    pc:deonticType pcd:Obligation ;
    pc:groundedTerm pcd:Fire,
        pc:ProtectionClass,
        pc:ProtectiveSafeguard ;
    pc:mentions pcd:Fire,
        pcd:MM-CP-E415 ;
    pc:pageNumber 3 ;
    pc:sectionRef "SECTION 5 - VACANCY AND PROTECTIVE SAFEGUARDS / 5.2" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

