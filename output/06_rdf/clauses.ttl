        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 4.2" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 4 - PROOF OF LOSS AND PAYMENT 4.2 p.3] 4.2 Under Section E.4 we must state our coverage position within 30 days of receiving the proof of loss and pay undisputed amounts within 30 days." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "4.2 Under Section E.4 we must state our coverage position within 30 days of receiving the proof of loss and pay undisputed amounts within 30 days." ;
    pc:confidence 1.0 ;
