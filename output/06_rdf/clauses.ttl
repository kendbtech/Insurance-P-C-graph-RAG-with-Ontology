pcd:MM-RM-CP-2025_RULE-8_8.1 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-RM-CP-2025 8.1" ;
    prov:wasDerivedFrom pcd:MM-RM-CP-2025 ;
    pc:chunkText "[MM-RM-CP-2025 RULE 8 - WORKED EXAMPLE 8.1 p.3] 8.1 A CC4 office building (class code 0745) in territory FL-T03 with COV-A limit $4,000,000, PC4, $5,000 deductible, 5% windstorm deductible (MM-CP-E310) and full sprinklers (SPR-1 with MM-CP-E415): 4,000,000 / 100 x 0.240 x 1.45 x 1.00 x 0.95 x 0.80 x 0.85 = $8,992 COV-A premium before fees." ;
    pc:classifierRoute "pass2-rules" ;
    pc:clauseText "8.1 A CC4 office building (class code 0745) in territory FL-T03 with COV-A limit $4,000,000, PC4, $5,000 deductible, 5% windstorm deductible (MM-CP-E310) and full sprinklers (SPR-1 with MM-CP-E415): 4,000,000 / 100 x 0.240 x 1.45 x 1.00 x 0.95 x 0.80 x 0.85 = $8,992 COV-A premium before fees." ;
    pc:confidence 0.34 ;
    pc:deonticType pcd:Permission ;
    pc:groundedTerm pcd:COV-A,
        pcd:CommercialProperty,
        pc:ProtectionClass ;
    pc:mentions pcd:CC-0745,
        pcd:CC4,
        pcd:COV-A,
        pcd:FL,
        pcd:FL-T03,
        pcd:MM-CP-E310,
        pcd:MM-CP-E415,
        pcd:PC4,
        pcd:SPR-1,
        pcd:Windstorm ;
    pc:pageNumber 3 ;
    pc:sectionRef "RULE 8 - WORKED EXAMPLE / 8.1" ;
    pc:sourceDocument pcd:MM-RM-CP-2025 .

