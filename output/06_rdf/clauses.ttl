pcd:MM-CP-0010_SECTION-A_A.3 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CP-0010 A.3" ;
    prov:wasDerivedFrom pcd:MM-CP-0010 ;
    pc:chunkText "[MM-CP-0010 SECTION A - COVERAGE A.3 p.1] A.3 Property Not Covered. Covered Property does not include: (a) accounts, bills, currency, deeds, money or securities; (b) land, water, growing crops or lawns; (c) vehicles or self-propelled machines that are licensed for use on public roads, except vehicles you manufacture, process or warehouse; (d) the cost to research, replace or restore the information on valuable papers and records, except as provided in the Coverage Extensions." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "A.3 Property Not Covered. Covered Property does not include: (a) accounts, bills, currency, deeds, money or securities; (b) land, water, growing crops or lawns; (c) vehicles or self-propelled machines that are licensed for use on public roads, except vehicles you manufacture, process or warehouse; (d) the cost to research, replace or restore the information on valuable papers and records, except as provided in the Coverage Extensions." ;
    pc:confidence 1.0 ;
    pc:deonticType pcd:Prohibition ;
    pc:groundedTerm pcd:COV-A,
        pcd:COV-B,
        pcd:COV-C ;
    pc:mentions pcd:Water ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION A - COVERAGE / A.3" ;
    pc:sourceDocument pcd:MM-CP-0010 .

