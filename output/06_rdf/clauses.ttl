    rdfs:label "MM-CP-E-SERIES 1.4" ;
    prov:wasDerivedFrom pcd:MM-CP-E-SERIES ;
    pc:chunkText "[MM-CP-E-SERIES 1. MM-CP-E101 - FLOOD COVERAGE ENDORSEMENT - SCHEDULED LOCATIONS (Ed. 06/2025) 1.4 p.1] 1.4 Limitations. We will not pay under this endorsement for loss to property in the open, for loss at any location that is not a scheduled location, or for loss caused by Flood that begins before the effective date of this endorsement or within 72 hours after it. Coverage COV-D (Business Income) is not extended by this endorsement unless the Schedule shows a COV-D Flood Sublimit." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "1.4 Limitations. We will not pay under this endorsement for loss to property in the open, for loss at any location that is not a scheduled location, or for loss caused by Flood that begins before the effective date of this endorsement or within 72 hours after it. Coverage COV-D (Business Income) is not extended by this endorsement unless the Schedule shows a COV-D Flood Sublimit." ;
    pc:confidence 0.769 ;
    pc:deonticType pcd:Prohibition ;
    pc:groundedTerm pcd:COV-D,
        pcd:CommercialProperty,
        pc:Coverage ;
    pc:mentions pcd:COV-D,
        pcd:Flood ;
    pc:pageNumber 1 ;
    pc:sectionRef "1. MM-CP-E101 - FLOOD COVERAGE ENDORSEMENT - SCHEDULED LOCATIONS (Ed. 06/2025) / 1.4" ;
    pc:sourceDocument pcd:MM-CP-E-SERIES .

