pcd:MM-CM-CP-2025_SECTION-1_1.2 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 1.2" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 1 - FIRST NOTICE OF LOSS (FNOL) 1.2 p.1] 1.2 The adjuster must acknowledge receipt of every claim in writing within 14 calendar days in Florida and within 15 business days in Texas, per the applicable state claims-handling requirements referenced in Filings MM-FL-2025-0142 and MM-TX-2025-0098." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "1.2 The adjuster must acknowledge receipt of every claim in writing within 14 calendar days in Florida and within 15 business days in Texas, per the applicable state claims-handling requirements referenced in Filings MM-FL-2025-0142 and MM-TX-2025-0098." ;
    pc:confidence 1.0 ;
    pc:deonticType pcd:Obligation ;
    pc:groundedTerm pcd:FL,
        pc:Claim,
        pc:ClaimsManual ;
    pc:mentions pcd:FL,
        pcd:MM-FL-2025-0142,
        pcd:MM-TX-2025-0098,
        pcd:TX ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION 1 - FIRST NOTICE OF LOSS (FNOL) / 1.2" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-1_1.3 a pc:Chunk,
        pc:Clause ;
