    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 3 - RESERVES AND AUTHORITY 3.1 p.3] 3.1 An adjuster must not set a reserve or issue a payment above his or her authority." ;
    pc:classifierRoute "pass2-rules" ;
    pc:clauseText "3.1 An adjuster must not set a reserve or issue a payment above his or her authority." ;
