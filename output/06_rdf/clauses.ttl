pcd:MM-CM-CP-2025_SECTION-3_T1 a pc:Chunk ;
    rdfs:label "MM-CM-CP-2025 table Adjuster Level / Reserve Authority / Payment Authority" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 3 - RESERVES AND AUTHORITY table p.3] Adjuster Level: Adjuster I ; Reserve Authority: $25,000 ; Payment Authority: $15,000 ; Escalation: Adjuster II | Adjuster Level: Adjuster II ; Reserve Authority: $100,000 ; Payment Authority: $75,000 ; Escalation: Claims Supervisor | Adjuster Level: Claims Supervisor ; Reserve Authority: $500,000 ; Payment Authority: $350,000 ; Escalation: Claims Manager | Adjuster Level: Claims Manager ; Reserve Authority: $2,000,000 ; Payment Authority: $1,500,000 ; Escalation: VP Claims; notify reinsurance above $1,000,000" ;
    pc:pageNumber 3 ;
    pc:sectionRef "SECTION 3 - RESERVES AND AUTHORITY / table" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-4_4.1 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 4.1" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 4 - PROOF OF LOSS AND PAYMENT 4.1 p.3] 4.1 Under MM-CP-0010 Section E.3(d) the insured must submit a signed, sworn proof of loss within 60 days of our request. The adjuster may extend this period in writing." ;
    pc:classifierRoute "pass2-rules" ;
    pc:clauseText "4.1 Under MM-CP-0010 Section E.3(d) the insured must submit a signed, sworn proof of loss within 60 days of our request. The adjuster may extend this period in writing." ;
    pc:confidence 0.533 ;
    pc:deonticType pcd:Obligation ;
    pc:groundedTerm pc:Claim,
        pc:Coverage,
        pc:Form ;
    pc:mentions pcd:MM-CP-0010 ;
    pc:pageNumber 3 ;
    pc:sectionRef "SECTION 4 - PROOF OF LOSS AND PAYMENT / 4.1" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

