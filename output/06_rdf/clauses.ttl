    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 3 - RESERVES AND AUTHORITY 3.2 p.3] 3.2 Initial reserves must be set within 5 business days of FNOL and reviewed every 30 days." ;
