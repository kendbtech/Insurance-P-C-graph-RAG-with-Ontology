    prov:wasDerivedFrom pcd:MM-RM-CP-2025 ;
    pc:chunkText "[MM-RM-CP-2025 RULE 8 - WORKED EXAMPLE 8.2 p.3] 8.2 Adding MM-CP-E101 with a $250,000 flood sublimit in zone AE adds 250,000 / 100 x 0.900 = $2,250." ;
