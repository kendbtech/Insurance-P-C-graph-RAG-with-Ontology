pcd:MM-CM-CP-2025_SECTION-2_2.4 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 2.4" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 2 - COVERAGE VERIFICATION 2.4 p.1] 2.4 If MM-CP-E101 is not attached, or the premises is not a scheduled location, Flood damage is not covered and a reservation of rights letter must be issued within 10 business days." ;
    pc:classifierRoute "pass2-rules" ;
    pc:clauseText "2.4 If MM-CP-E101 is not attached, or the premises is not a scheduled location, Flood damage is not covered and a reservation of rights letter must be issued within 10 business days." ;
    pc:confidence 0.579 ;
    pc:deonticType pcd:Prohibition ;
    pc:groundedTerm pcd:CommercialProperty,
        pc:FloodZone,
        pc:Location ;
    pc:mentions pcd:Flood,
        pcd:MM-CP-E101 ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION 2 - COVERAGE VERIFICATION / 2.4" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-2_T1 a pc:Chunk ;
    rdfs:label "MM-CM-CP-2025 table Cause of Loss / Exclusion Code / Restoring Endorsement" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 2 - COVERAGE VERIFICATION table p.1] Cause of Loss: Flood / surface water ; Exclusion Code: EXCL-FLD ; Restoring Endorsement: MM-CP-E101 (scheduled locations only) ; Coverage Position: Covered only if E101 attached and location scheduled | Cause of Loss: Earth movement ; Exclusion Code: EXCL-EQ ; Restoring Endorsement: None available ; Coverage Position: Not covered | Cause of Loss: Mechanical breakdown ; Exclusion Code: B.2.d ; Restoring Endorsement: MM-CP-E205 ; Coverage Position: Covered up to $100,000 if E205 attached | Cause of Loss: Windstorm / hail ; Exclusion Code: None (covered peril) ; Restoring Endorsement: MM-CP-E310 changes deductible ; Coverage Position: Covered, apply 2% or 5% deductible | Cause of Loss: Fire with impaired sprinkler ; Exclusion Code: MM-CP-E415 4.3 ; Restoring Endorsement: None ; Coverage Position: Not covered if insured knew of impairment and did not notify | Cause of Loss: Fungus / mold ; Exclusion Code: EXCL-MOLD ; Restoring Endorsement: None available ; Coverage Position: Not covered except limited $15,000 clean-up" ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION 2 - COVERAGE VERIFICATION / table" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

