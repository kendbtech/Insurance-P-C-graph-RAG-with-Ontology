    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 6 - SUBROGATION AND SALVAGE 6.2 p.3] 6.2 Salvage must be offered for sale within 30 days of payment where the recovery is expected to exceed $2,500." ;
