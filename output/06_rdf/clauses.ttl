    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-2_2.1 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 2.1" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 2 - COVERAGE VERIFICATION 2.1 p.1] 2.1 The adjuster must verify that the form edition and endorsements on the policy match the editions approved in the applicable State Filing before issuing any coverage position." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "2.1 The adjuster must verify that the form edition and endorsements on the policy match the editions approved in the applicable State Filing before issuing any coverage position." ;
    pc:confidence 0.714 ;
    pc:deonticType pcd:Obligation ;
    pc:groundedTerm pc:ClaimsManual,
        pc:Form,
        pc:StateAmendatoryEndorsement ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION 2 - COVERAGE VERIFICATION / 2.1" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-2_2.2 a pc:Chunk,
        pc:Clause ;
    rdfs:label "MM-CM-CP-2025 2.2" ;
    prov:wasDerivedFrom pcd:MM-CM-CP-2025 ;
    pc:chunkText "[MM-CM-CP-2025 SECTION 2 - COVERAGE VERIFICATION 2.2 p.1] 2.2 For any loss involving water, the adjuster must determine whether the cause of loss is Flood as excluded by EXCL-FLD in MM-CP-1030 Section B.1.g, and then check whether MM-CP-E101 is attached and whether the damaged premises is a scheduled location under that endorsement." ;
    pc:classifierRoute "pass1" ;
    pc:clauseText "2.2 For any loss involving water, the adjuster must determine whether the cause of loss is Flood as excluded by EXCL-FLD in MM-CP-1030 Section B.1.g, and then check whether MM-CP-E101 is attached and whether the damaged premises is a scheduled location under that endorsement." ;
    pc:confidence 1.0 ;
    pc:deonticType pcd:Obligation ;
    pc:groundedTerm pcd:Flood,
        pc:Claim,
        pc:FloodZone ;
    pc:mentions pcd:EXCL-FLD,
        pcd:Flood,
        pcd:MM-CP-1030,
        pcd:MM-CP-E101,
        pcd:Water ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION 2 - COVERAGE VERIFICATION / 2.2" ;
    pc:sourceDocument pcd:MM-CM-CP-2025 .

pcd:MM-CM-CP-2025_SECTION-2_2.3_x1 a pc:Clause ;
    pc:clauseText "unless the Schedule shows a COV-D Flood Sublimit." ;
    pc:exceptionTo pcd:MM-CM-CP-2025_SECTION-2_2.3 ;
    pc:pageNumber 1 ;
    pc:sectionRef "SECTION 2 - COVERAGE VERIFICATION / 2.3 (exception)" ;
