  "q11_clause_neighbourhood": {
    "title": "Graph RAG helper: clauses that mention a given entity, with citation fields (used by 09_graph_rag.py as a template)",
    "columns": [
      "clause",
      "deontic",
      "document",
      "section",
      "page",
      "text"
    ],
    "rows": [
      {
        "clause": "MM-CM-CP-2025 2.2",
        "deontic": "Obligation",
        "document": "MM-CM-CP-2025",
        "section": "SECTION 2 - COVERAGE VERIFICATION / 2.2",
        "page": "1",
        "text": "2.2 For any loss involving water, the adjuster must determine whether the cause of loss is Flood as excluded by EXCL-FLD in MM-CP-1030 Section B.1.g, and then check whether MM-CP-E101 is attached and whether the damaged premises is a scheduled location under that endorsement."
      },
      {
        "clause": "MM-CM-CP-2025 2.3",
        "deontic": "Permission",
        "document": "MM-CM-CP-2025",
        "section": "SECTION 2 - COVERAGE VERIFICATION / 2.3",
        "page": "1",
        "text": "2.3 If MM-CP-E101 is attached and the premises is a scheduled location, Flood damage to COV-A and COV-B is covered up to the Flood Sublimit of $250,000 subject to the 5% Flood Deductible; COV-D is not covered unless the Schedule shows a COV-D Flood Sublimit."
      },
      {
        "clause": "MM-CM-CP-2025 2.4",
        "deontic": "Prohibition",
        "document": "MM-CM-CP-2025",
        "section": "SECTION 2 - COVERAGE VERIFICATION / 2.4",
        "page": "1",
        "text": "2.4 If MM-CP-E101 is not attached, or the premises is not a scheduled location, Flood damage is not covered and a reservation of rights letter must be issued within 10 business days."
      },
      {
        "clause": "MM-CM-CP-2025 4.3",
        "deontic": "Obligation",
        "document": "MM-CM-CP-2025",
        "section": "SECTION 4 - PROOF OF LOSS AND PAYMENT / 4.3",
        "page": "3",
        "text": "4.3 When a percentage deductible applies under MM-CP-E310 or MM-CP-E101, the adjuster must document the Limit of Insurance used to calculate the deductible and the resulting dollar amount."
      },
      {
        "clause": "MM-CP-0010 G.1",
        "deontic": "Permission",
        "document": "MM-CP-0010",
        "section": "SECTION G - OPTIONAL COVERAGES AND ENDORSEMENTS / G.1",
        "page": "3",
        "text": "G.1 The following endorsements may be attached to this form when shown in the Declarations: MM-CP-E101 Flood Coverage Endorsement - Scheduled Locations; MM-CP-E205 Equipment Breakdown Endorsement; MM-CP-E310 Windstorm or Hail Percentage Deductible; MM-CP-E415 Protective Safeguards Endorsement. State amendatory endorsements such as MM-CP-FL-01 (Florida) are attached automatically where required by the state filing."
      },
      {
        "clause": "MM-FILINGS-CP-2025 3.2",
        "deontic": "Prohibition",
        "document": "MM-FILINGS-CP-2025",
        "section": "FILING 3 - NEW YORK (NY) - MM-NY-2025-0211 / 3.2",
        "page": "2",
        "text": "3.2 Forms MM-CP-E101 and MM-CP-E310 were not included in this filing and must not be used in New York."
      },
      {
        "clause": "MM-RM-CP-2025 8.2",
        "deontic": "Permission",
        "document": "MM-RM-CP-2025",
        "section": "RULE 8 - WORKED EXAMPLE / 8.2",
        "page": "3",
        "text": "8.2 Adding MM-CP-E101 with a $250,000 flood sublimit in zone AE adds 250,000 / 100 x 0.900 = $2,250."
      },
      {
        "clause": "MM-UW-CP-2025 2.2",
        "deontic": "Permission",
        "document": "MM-UW-CP-2025",
        "section": "SECTION 2 - ELIGIBILITY / 2.2",
        "page": "1",
        "text": "2.2 Referral Risks. The following risks may be written only with Underwriting Manager approval: Protection Class PC9 or PC10; buildings over 50 years old without updated electrical, plumbing, heating and roof within the last 25 years; class code 0921 (Vacant Buildings); any location in FEMA flood zone A, AE, V or VE that does not carry MM-CP-E101."
      },
      {
        "clause": "MM-UW-CP-2025 4.4",
        "deontic": "Obligation",
        "document": "MM-UW-CP-2025",
        "section": "SECTION 4 - REQUIRED ENDORSEMENTS AND FORMS / 4.4",
        "page": "3",
        "text": "4.4 Any scheduled location in FEMA flood zone A, AE, V or VE must carry MM-CP-E101 Flood Coverage Endorsement, or the insured must sign a Flood Exclusion Acknowledgment form before binding."
