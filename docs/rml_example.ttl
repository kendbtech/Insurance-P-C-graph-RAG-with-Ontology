# RML alternative for the 'Endorsement Availability Matrix' mapping implemented in Python in scripts/06_build_rdf.py.
# Logical source = the table exported as CSV by Layer 1 (one row per endorsement). Run with RMLMapper or Morph-KGC.
# Same subject IRIs and predicates as the Python mapping, so the two approaches are interchangeable.
@prefix rr:   <http://www.w3.org/ns/r2rml#> .
@prefix rml:  <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:   <http://semweb.mmlab.be/ns/ql#> .
@prefix pc:   <https://example.org/pc/ontology#> .
@prefix pcd:  <https://example.org/pc/id/> .
@prefix ex:   <https://example.org/pc/mapping/> .

ex:EndorsementMatrixMap a rr:TriplesMap ;
    rml:logicalSource [ rml:source "output/01_clause_tree/tables/endorsement_matrix.csv" ;
                        rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/pc/id/{Endorsement}" ; rr:class pc:Endorsement ] ;
    rr:predicateObjectMap [ rr:predicate pc:formNumber  ; rr:objectMap [ rml:reference "Endorsement" ] ] ;
    rr:predicateObjectMap [ rr:predicate pc:editionDate ; rr:objectMap [ rml:reference "Edition" ] ] ;
    # multi-valued cells ("COV-A, COV-B") need a split: either pre-split the CSV in Layer 1 (recommended for a POC)
    # or use an RML function (FnO grel:string_split) - the Python mapping simply uses a regex.
    rr:predicateObjectMap [ rr:predicate pc:modifiesCoverage ;
                            rr:objectMap [ rr:template "https://example.org/pc/id/{ModifiesCoverage}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate pc:modifiesForm ;
                            rr:objectMap [ rr:template "https://example.org/pc/id/{ModifiesForm}" ; rr:termType rr:IRI ] ] .

# Layer 6 (virtualization): the same idea applied to the policy-admin tables. A CDC event for row policy_id=123 is
# mapped by this TriplesMap into the few triples that describe that one record, and only those are validated.
ex:PolicyMap a rr:TriplesMap ;
    rml:logicalSource [ rml:source "policy_admin.policy" ; rml:referenceFormulation ql:CSV ] ;
    rr:subjectMap [ rr:template "https://example.org/pc/id/policy/{policy_number}" ; rr:class pc:Policy ] ;
    rr:predicateObjectMap [ rr:predicate pc:policyNumber ; rr:objectMap [ rml:reference "policy_number" ] ] ;
    rr:predicateObjectMap [ rr:predicate pc:inState ; rr:objectMap [ rr:template "https://example.org/pc/id/{state_code}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate pc:hasEndorsement ; rr:objectMap [ rr:template "https://example.org/pc/id/{endorsement_form_number}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate pc:totalInsuredValue ; rr:objectMap [ rml:reference "tiv" ; rr:datatype <http://www.w3.org/2001/XMLSchema#decimal> ] ] .
